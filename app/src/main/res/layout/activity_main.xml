<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:clipToPadding="false"
    android:padding="0sp"
    android:paddingStart="0sp"
    android:paddingLeft="0sp"
    android:paddingTop="0sp"
    android:paddingEnd="0sp"
    android:paddingRight="0sp"
    android:paddingBottom="0sp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/Tytol"
        android:layout_width="0dp"
        android:layout_height="37dp"
        android:background="#055DF7"
        android:text="Planer treningów"
        android:textAlignment="center"
        android:textColor="#FAFBFD"
        android:textSize="26sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <ImageView
        android:id="@+id/sportowiec"
        android:layout_width="0dp"
        android:layout_height="235dp"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Tytol"
        app:srcCompat="@drawable/sportowiec"
        tools:ignore="MissingConstraints" />

    <Button
        android:id="@+id/losCwiczenie"
        android:layout_width="383dp"
        android:layout_height="51dp"
        android:backgroundTint="#055CF5"
        android:text="LOSUJ ĆWICZENIE"
        android:textSize="24sp"
        app:cornerRadius="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sportowiec"
        app:layout_constraintVertical_bias="0.017" />

    <ImageView
        android:id="@+id/cwiczeniaZdj"
        android:layout_width="382dp"
        android:layout_height="231dp"
        android:background="#EFF4FC"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.516"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/losCwiczenie"
        app:layout_constraintVertical_bias="0.054"
        app:srcCompat="@drawable/cwiczenie0" />

    <TextView
        android:id="@+id/NazwaCwicenia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Losuj ćwiczenie"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cwiczeniaZdj"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/zmniejsz"
        android:layout_width="71dp"
        android:layout_height="59dp"
        android:layout_marginStart="52dp"
        android:backgroundTint="#BBC7DB"
        android:gravity="center"
        android:includeFontPadding="false"
        android:padding="0sp"
        android:paddingStart="0sp"
        android:paddingLeft="0sp"
        android:paddingTop="0sp"
        android:paddingEnd="0sp"
        android:paddingRight="0sp"
        android:paddingBottom="0sp"
        android:text="-"
        android:textAlignment="center"
        android:textColor="#000000"
        android:textSize="48sp"
        android:textStyle="bold"
        app:cornerRadius="10sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/zwieksz"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cwiczeniaZdj"
        app:layout_constraintVertical_bias="0.19" />

    <Button
        android:id="@+id/zwieksz"
        android:layout_width="71dp"
        android:layout_height="59dp"
        android:layout_marginEnd="52dp"
        android:backgroundTint="#BBC7DB"
        android:gravity="center"
        android:includeFontPadding="false"
        android:padding="0sp"
        android:paddingStart="0sp"
        android:paddingLeft="0sp"
        android:paddingTop="0sp"
        android:paddingEnd="0sp"
        android:paddingRight="0sp"
        android:paddingBottom="0sp"
        android:text="+"
        android:textAlignment="center"
        android:textColor="#000000"
        android:textSize="48sp"
        android:textStyle="bold"
        app:cornerRadius="10sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cwiczeniaZdj"
        app:layout_constraintVertical_bias="0.19" />

    <TextView
        android:id="@+id/liczbaSerii"
        android:layout_width="63dp"
        android:layout_height="59dp"
        android:text="0"
        android:textAlignment="center"
        android:textSize="48sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/zwieksz"
        app:layout_constraintStart_toEndOf="@+id/zmniejsz"
        app:layout_constraintTop_toBottomOf="@+id/NazwaCwicenia"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/nastCwicz"
        android:layout_width="176dp"
        android:layout_height="113dp"
        android:backgroundTint="#069D56"
        android:text="NASTĘPNE ĆWICZENIE"
        android:textSize="20sp"
        app:cornerRadius="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.077"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.925" />

    <Button
        android:id="@+id/reset"
        android:layout_width="179dp"
        android:layout_height="114dp"
        android:backgroundTint="#E7212B"
        android:text="RESET"
        android:textSize="20sp"
        app:cornerRadius="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.944"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.925" />

    <TextView
        android:id="@+id/LacznaLiczbaSerii"
        android:layout_width="380dp"
        android:layout_height="36dp"
        android:background="#E4EBF8"
        android:text="Łączna liczba serii: 0"
        android:textAlignment="center"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.575"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.99" />

</androidx.constraintlayout.widget.ConstraintLayout>